// Prisma schema for THE LORDS Finance OS.
// Connection URLs live in prisma.config.ts (CLI) and src/lib/db.ts (runtime adapter).
//
// Conventions
// - Money: Decimal(24, 8) (covers fiat, USDT's 6 decimals and 8-decimal crypto). Rates/shares as
//   fractions (0.25 = 25%): Decimal(12, 8). FX rates: Decimal(28, 12).
// - Currency: code referencing the Currency table (USD, EUR, GBP, USDT, ...). Each organization has a
//   base (reporting) currency; foreign amounts carry fxRate and baseAmount so historical reports
//   never depend on today's rates. Amounts are rounded to Currency.decimals by the application.
// - Access: all tables have row level security. Policies (read-only, permission-based) live in
//   prisma/migrations/*_authorization; writes go through the server, which checks permissions.
// - History: monthly data is keyed by FinancialPeriod; salary, assignments, rules and ownership are
//   effective-dated (validFrom inclusive, validTo exclusive, null = open-ended). Payroll items snapshot
//   the conditions they were calculated from. Closed periods are locked by database triggers.
// - The general ledger (JournalEntry/JournalLine) is the single source of truth for P&L, Balance Sheet
//   and Cash Flow. Operational records (payroll, project income/costs, distributions) link to the
//   journal entry that posted them.
// - Integrity rules Prisma cannot express (CHECKs, period locks, double-entry balance, append-only
//   audit log, row level security) live in prisma/migrations/*_integrity_rules/migration.sql.
// - Table/column names are snake_case via @map/@@map.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum CurrencyKind {
  FIAT
  STABLECOIN
  CRYPTO

  @@map("currency_kind")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum PeriodStatus {
  OPEN
  CLOSING // books being finalized; only users with period:close may post
  CLOSED // no changes; can be reopened by period:reopen
  LOCKED // permanently locked (e.g. after audit/tax filing)

  @@map("period_status")
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  TERMINATED

  @@map("employee_status")
}

enum AgreementType {
  EMPLOYMENT_FULL_TIME
  EMPLOYMENT_PART_TIME
  CONTRACTOR
  FREELANCE
  INTERNSHIP

  @@map("agreement_type")
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED

  @@map("agreement_status")
}

enum PayBasis {
  MONTHLY
  HOURLY
  DAILY
  FIXED_FEE

  @@map("pay_basis")
}

enum CompensationType {
  KPI_BONUS
  COMMISSION
  FIXED_BONUS
  ALLOWANCE
  OVERTIME
  DEDUCTION

  @@map("compensation_type")
}

enum CalculationMethod {
  FIXED_AMOUNT
  PERCENT_OF_BASE
  PERCENT_OF_METRIC // e.g. % of project revenue or KPI value
  TIERED
  PER_UNIT

  @@map("calculation_method")
}

/// What a compensation rule's metric is measured against: the whole KPI actual, only the part above
/// the employee's KPI target, or the whole actual but only when the target is met.
enum MetricBasis {
  TOTAL
  ABOVE_TARGET
  TOTAL_IF_TARGET_MET

  @@map("metric_basis")
}

enum KpiUnit {
  COUNT
  CURRENCY
  PERCENT
  RATIO
  DURATION_HOURS

  @@map("kpi_unit")
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER

  @@map("kpi_direction")
}

enum KpiAggregation {
  SUM
  AVERAGE
  LAST
  MAX
  MIN

  @@map("kpi_aggregation")
}

enum KpiScope {
  ORGANIZATION
  DEPARTMENT
  TEAM
  EMPLOYEE

  @@map("kpi_scope")
}

enum DataSource {
  MANUAL
  IMPORT
  INTEGRATION
  SYSTEM

  @@map("data_source")
}

enum PayrollRunType {
  REGULAR
  OFF_CYCLE
  CORRECTION

  @@map("payroll_run_type")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  SUBMITTED
  APPROVED
  PAYING
  PAID
  CANCELLED

  @@map("payroll_run_status")
}

enum PayrollLineType {
  BASE_SALARY
  KPI_BONUS
  COMMISSION
  BONUS
  ALLOWANCE
  OVERTIME
  REIMBURSEMENT
  DEDUCTION
  ADVANCE_RECOVERY
  TAX_WITHHOLDING
  EMPLOYER_CONTRIBUTION
  ADJUSTMENT

  @@map("payroll_line_type")
}

enum AdjustmentType {
  BONUS
  CORRECTION
  DEDUCTION
  REIMBURSEMENT
  ADVANCE
  ADVANCE_RECOVERY

  @@map("adjustment_type")
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED

  @@map("adjustment_status")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED

  @@map("approval_decision")
}

enum PaymentMethod {
  BANK_TRANSFER
  CRYPTO
  PAYMENT_SERVICE
  CASH
  OTHER

  @@map("payment_method")
}

enum PaymentStatus {
  SCHEDULED
  SENT
  CONFIRMED
  FAILED
  REVERSED

  @@map("payment_status")
}

enum WalletType {
  BANK_ACCOUNT
  CRYPTO_WALLET
  PAYMENT_SERVICE

  @@map("wallet_type")
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE

  @@map("client_status")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum BillingModel {
  FIXED_PRICE
  TIME_AND_MATERIALS
  RETAINER
  REVENUE_SHARE
  INTERNAL

  @@map("billing_model")
}

enum IncomeStatus {
  PLANNED
  INVOICED
  PARTIALLY_RECEIVED
  RECEIVED
  WRITTEN_OFF

  @@map("income_status")
}

enum CostStatus {
  PLANNED
  INCURRED
  PAID
  CANCELLED

  @@map("cost_status")
}

enum CategoryKind {
  REVENUE
  COST_OF_SALES
  OPERATING_EXPENSE
  DEPRECIATION
  AMORTIZATION
  INTEREST
  TAX
