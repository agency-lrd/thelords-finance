# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key, safe for the browser (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Pooled connection string used by the app at runtime (Connect > Transaction pooler, port 6543)
# TLS is verified against the pinned Supabase root CA in src/lib/db-ssl.ts; keep sslmode=require.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler connection string for the Prisma CLI / migrations (Connect > Session pooler, port 5432).
# Same user and password as DATABASE_URL. Run the CLI via `npm run db:prisma -- <command>` (verified TLS relay).
DIRECT_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Encrypts employee wallet addresses (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the same value in every environment that reads the same database; losing it makes stored wallets unreadable.
WALLET_ENCRYPTION_KEY=

# Email allowed to claim the first Super Admin account (Supabase Auth sign-up + email confirmation).
SUPER_ADMIN_EMAIL=

# AI CFO (optional). Server-side only; never prefix with NEXT_PUBLIC_. Without it the AI CFO page shows
# calculated figures and a "not configured" notice, and the chat is disabled.
ANTHROPIC_API_KEY=
# Limits (defaults shown). Spend is estimated from token usage; set a budget to 0 to turn the AI off.
# AI_CFO_MODEL=claude-opus-5-5
# AI_CFO_EFFORT=medium
# AI_CFO_MAX_OUTPUT_TOKENS=16000
# AI_CFO_MAX_TOOL_ROUNDS=8
# AI_CFO_MAX_MESSAGE_CHARS=4000
# AI_CFO_HISTORY_MESSAGES=20
# AI_CFO_RATE_PER_MINUTE=6
# AI_CFO_RATE_PER_DAY=150
# AI_CFO_USER_DAILY_BUDGET_USD=10
# AI_CFO_MONTHLY_BUDGET_USD=100
